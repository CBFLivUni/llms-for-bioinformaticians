[140.591, "o", "\r\n\u001b[?2004l\r"]
[140.595, "o", "dds <- DESeq(dds)\r\n\r\nres <- results(dds, name = \"dex_trt_vs_untrt\", alpha = 0.05)\r\nsummary(res)\r\n\r\nres_df <- as.data.frame(res)\r\nres_df <- res_df[!is.na(res_df$padj), ]\r\nres_df$symbol <- symbols[rownames(res_df)]\r\nwrite.csv(res_df[order(res_df$padj), ], \"deseq2_dex_trt_vs_untrt.csv\")\r\n\r\nplot_df <- res_df[, c(\"log2FoldChange\", \"padj\")]\r\nrownames(plot_df) <- make.unique(res_df$symbol)\r\n\r\nvolcano <- plotVolcano(plot_df,\r\n                       title = \"Dexamethasone vs untreated\",\r\n                       top.genes = 10,\r\n                       quadrants = TRUE,\r\n                       foldChangeColumn = \"log2FoldChange\",\r\n                       FDRColumn = \"padj\",\r\n                       logFCThreshold = 1,\r\n                       adjPValThreshold = 0.05,\r\n                       colours = c(\"Down-regulated\" = \"#4858A7\",\r\n                                   \"Unchanged\"      = \"grey70\",\r\n                                   \"Up-regulated\"   = \"#B51F29\"))\r\n\r\nsave_plot(\"volcano_dex.png\", volcano, base_width = 7, base_height = 6, dpi = 300, bg = \"white\")\r\nsave_plot(\"volcano_dex.pdf\", volcano, base_width = 7, base_height = 6)\r\n"]
[140.596, "o", "\u001b[?2004h\u001b[1;34mairway\u001b[0m $ "]
