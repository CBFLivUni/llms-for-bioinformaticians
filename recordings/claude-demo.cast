[133.867, "o", "suppressPackageStartupMessages({\r\n  library(DESeq2)\r\n  library(cowplot)\r\n})\r\n\r\nsource(\"/home/njs289/.claude/skills/cbf-dataviz/scripts/plottingFunctions.R\")\r\n\r\ncounts <- read.delim(\"airway_counts.tsv\", check.names = FALSE)\r\nsamples <- read.delim(\"airway_samples.tsv\", colClasses = \"character\")\r\n\r\n# Symbols repeat (e.g. 5S_rRNA, 7SK), so key rows on Ensembl ID and keep\r\n# symbols aside for labelling.\r\ncount_mat <- as.matrix(counts[, samples$sample])\r\nrownames(count_mat) <- counts$gene_id\r\nsymbols <- setNames(counts$symbol, counts$gene_id)\r\n\r\n# cell is the donor cell line, so each treated sample is paired with an\r\n# untreated one from the same line. It must be a factor (read as character,\r\n# never numeric) and go in the design as a blocking term so the dex effect is\r\n# estimated within cell line. dex is releveled so log2FC is trt vs untrt.\r\nrownames(samples) <- samples$sample\r\nsamples$cell <- factor(samples$cell)\r\nsamples$dex <- relevel(factor(samples$dex), ref = \"untrt\")\r\nsamples <- samples[colnames(count_mat), , drop = FALSE]\r\nstopifnot(identical(rownames(samples), colnames(count_mat)))\r\n\r\ndds <- DESeqDataSetFromMatrix(count_mat, colData = samples, design = ~ cell + dex)\r\ndds <- dds[rowSums(counts(dds) >= 10) >= 4, ]\r\n"]
