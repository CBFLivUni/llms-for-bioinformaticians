[120.585, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[2C\u001b[19B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m/\u001b[1mexi\u001b[22mt                                            \u001b[1mExi\u001b[22mt the CLI\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m/anthropic-skills:pptx                           Use this skill any time a .pptx or .potx file is involved in any way —\r\u001b[2C\u001b[1B\u001b[39m                                                 \u001b[38;2;153;153;153mas inpu\u001b[60G, output, or both. This\u001b[84Gincludes:\u001b[94Gc\u001b[96Geat\u001b[100Gng slide decks, pitch …\r\u001b[3C\u001b[1Banthropic-skills:skill-creator\u001b[53Greate new sk\u001b[66Glls,\u001b[71Gmodify and \u001b[83Gmprove \u001b[39m\u001b[1mexi\u001b[22m\u001b[38;2;153;153;153msting skills, and measure\u001b[39m\u001b[K\r\u001b[51C\u001b[1B\u001b[38;2;153;153;153mskill p\u001b[60Grformance. Use when users\u001b[86Gwant to create a skill from scratch,\r\u001b[5C\u001b[2B\u001b[39mi\u001b[30;1H\u001b[27;7H\u001b[?25h\u001b[?2026l"]
