[120.319, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[2C\u001b[19B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m/\u001b[1me\u001b[22mxit                                            \u001b[1mE\u001b[22mxit the CLI\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m/\u001b[39m\u001b[1me\u001b[22m\u001b[38;2;153;153;153mffort                                          S\u001b[39m\u001b[1me\u001b[22m\u001b[38;2;153;153;153mt effort level for model usage\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m/\u001b[39m\u001b[1me\u001b[22m\u001b[38;2;153;153;153mxport                                          \u001b[39m\u001b[1mE\u001b[22m\u001b[38;2;153;153;153mxport the current conversation to a file or clipboard\u001b[39m\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;153;153;153mbf-dataviz       \u001b[52GCBF (Computational Biology Facil\u001b[85Gty)\u001b[89Ghous\u001b[39m\u001b[1me\u001b[22m\u001b[38;2;153;153;153m style\u001b[101Ga\u001b[103Gd helper functions\r\u001b[51C\u001b[1Bfor sci\u001b[39m\u001b[1me\u001b[22m\u001b[38;2;153;153;153mntific dat\u001b[71G visualisation \u001b[87Gn R/ggplot2.\u001b[100GUse whenever producing\r\u001b[3C\u001b[2B\u001b[39me\u001b[30;1H\u001b[27;5H\u001b[?25h\u001b[?2026l"]
