[99.65, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3G-\u001b[5GThe script\u001b[16Gputs\u001b[21Gthe\u001b[25Gsample\u001b[32Gsheet\u001b[38Gin\u001b[41Gthe\u001b[45Gsame\u001b[50Gorder\u001b[56Gas\u001b[59Gthe\u001b[63Gcount\u001b[69Gcolumns\u001b[77Gand\u001b[81Gchecks\u001b[88Gthe\u001b[92Gtwo\u001b[96Gmatch\u001b[102Gbefore\u001b[109Grunning\u001b[117GDESeq2.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOther choices\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSome\u001b[10Ggene\u001b[15Gsymbols\u001b[23Gappear\u001b[30Gmore\u001b[35Gthan\u001b[40Gonce\u001b[45G(e.g.\u001b[51G5S_rRNA,\u001b[60G7SK).\u001b[66GSo\u001b[69Gthe\u001b[73Ganalysis\u001b[82Guses\u001b[87GEnsembl\u001b[95GIDs,\u001b[100Gand\u001b[104Gsymbols\u001b[112Gare\u001b[116Gused\u001b[121Gonly\r\u001b[4C\u001b[1Bfor the labels on the plot.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI dropped low-count genes first, keeping genes with at least 10 counts in\u001b[79Gat\u001b[82Gleast\u001b[88G4\u001b[90Gsamples.\u001b[99GThat\u001b[104Gleft\u001b[109G15,826\u001b[116Ggenes\u001b[122Gto\r\u001b[4C\u001b[1Btest.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gplot\u001b[14Guses\u001b[19Gthe\u001b[23Gskill's\u001b[31G\u001b[38;2;177;185;249mplotVolcano\u001b[43G\u001b[39mwith\u001b[48Gcowplot\u001b[56Gstyling\u001b[64Gand\u001b[68Gthe\u001b[72GCBF\u001b[76Gblue/red\u001b[85Gcolours,\u001b[94Gand\u001b[98Gthe\u001b[102GPNG\u001b[106Gis\u001b[109Gsaved\u001b[115Gwith\u001b[120Ga\r\u001b[1B \u001b[3G  white backgr\u001b[18Gund.\u001b[K\r\u001b[1B  - A g\u001b[9Gne counts as changed at FDR <\u001b[39G0.05\u001b[44Gand |log2FC| ≥ 1. The\u001b[66G10\u001b[69Gmost\u001b[74Gsignificant\u001b[86Ggenes\u001b[92Gin\u001b[95Geach\u001b[100Gdirection\u001b[110Gare\u001b[114Glabelled.\r\u001b[2C\u001b[2B\u001b[1mResults:\u001b[22m 4,081 gen\u001b[23G pass FDR < 0.05. O\u001b[43G those, 490 g\u001b[57G up\u001b[61Gand\u001b[65G461\u001b[69Ggo\u001b[72Gdown\u001b[77Gby\u001b[80Gat\u001b[83Gleast\u001b[89G2-fold.\u001b[97GThe\u001b[101Gtop\u001b[105Ggenes\u001b[111Ginclude\u001b[119GDUSP1,\r\u001b[2C\u001b[1BSPARCL1, MAOA and\u001b[21GGPX3,\u001b[27Gwhich\u001b[33Gare\u001b[37Gknown\u001b[43Gdexamethasone-response\u001b[66Ggenes\u001b[72Gin\u001b[75Gthe\u001b[79Gairway\u001b[86Gdataset,\u001b[95Gso\u001b[98Gthe\u001b[102Gresult\u001b[109Glooks\u001b[115Gright.\r\u001b[1B\u001b[K\r\u001b[1B  The fold changes on the plot are the raw DESeq2 estimates, not shrunk. The one gene out near\u001b[96Glog2FC\u001b[103G9.5\u001b[107Gis\u001b[110Gprobably\u001b[119Ga\r\u001b[1B  low-count gene. If\u001b[22Gyou'd\u001b[28Grather\u001b[35Guse\u001b[39Gshrunk\u001b[46Gestimates\u001b[56G(apeglm\u001b[64Gis\u001b[67Ginstalled),\u001b[79Gthat's\u001b[86Ga\u001b[88Gone-line\u001b[97Gchange.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFiles\u001b[9Gare\u001b[13Gin\u001b[16G\u001b[38;2;177;185;249mdemos/airway/\u001b[39m:\r\u001b[1B \u001b[3G- \u001b[38;2;177;185;249mvolcano.R\u001b[39m: the script\u001b[27G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mvolcano_dex.png\r\u001b[1B\u001b[39m \u001b[3G- \u001b[38;2;177;185;249mvolcano_dex.pdf\u001b[39m\u001b[K\r\u001b[1B  - \u001b[38;2;177;185;249mdeseq2_dex_trt_vs_untrt.csv\u001b[39m:\u001b[34Gthe\u001b[38Gfull\u001b[43Gresults,\u001b[52Gsorted\u001b[59Gby\u001b[62Gadjusted\u001b[71Gp-value,\u001b[80Gwith\u001b[85Gsymbols\r\u001b[2C\u001b[2B\u001b[38;2;230;149;117mMeandering…\u001b[28G\u001b[38;2;153;153;153m7\u001b[39m\u001b[30;1H\u001b[27;3H\u001b[?25h\u001b[?2026l"]
